# Copy to .env and fill in for local development (`export $(cat .env | xargs)`
# or use a tool like direnv / python-dotenv).
# Not needed when running as a deployed Databricks App — those values are
# injected automatically by the `resources.postgres` binding.

PGHOST=<endpoint-host-from-databricks-postgres-get-endpoint>
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=<your-service-principal-or-user-id>
PGSSLMODE=require
PGAPPNAME=orders-dashboard-local

# projects/<project_id>/branches/production/endpoints/primary
LAKEBASE_ENDPOINT_NAME=projects/<project_id>/branches/production/endpoints/primary

# Optional tuning (defaults shown)
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10
POOL_TIMEOUT_S=30
CREDENTIAL_RETRIES=3
CREDENTIAL_RETRY_BACKOFF_S=0.5
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Optional: pin the Flask session/CSRF secret across restarts
# SECRET_KEY=
